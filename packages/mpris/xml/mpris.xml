<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">

<!--
  MPRIS 2.2 introspection data for mradio, used to generate sdbus-c++ adaptors.

  Source of truth: the freedesktop MPRIS specification, spec/org.mpris.MediaPlayer2.xml,
  spec/org.mpris.MediaPlayer2.Player.xml and spec/org.mpris.MediaPlayer2.TrackList.xml
  (rendered at https://specifications.freedesktop.org/mpris-spec/latest/). Names, D-Bus signatures,
  argument directions and EmitsChangedSignal annotations below are taken verbatim from
  those files; only the tp: docstrings were dropped and mradio-specific commentary added.

  Exported on the object path /org/mpris/MediaPlayer2 under the well-known bus name
  org.mpris.MediaPlayer2.mradio.
-->
<node>

  <!--
    Root interface. The spec annotates the whole interface with
    EmitsChangedSignal="true"; it is repeated per property here so that the generated
    adaptor carries the flag on every property registration explicitly.
  -->
  <interface name="org.mpris.MediaPlayer2">

    <!--
      mradio is headless (tray icon only, no window), so CanRaise is false and Raise()
      is a no-op. The method must still exist: the spec makes it mandatory regardless of
      CanRaise, and clients call it unconditionally.
    -->
    <method name="Raise"/>

    <!-- Backs the "Quit" entry in the tray menu; CanQuit is true. -->
    <method name="Quit"/>

    <property name="CanQuit" type="b" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <property name="CanRaise" type="b" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <!--
      true: the org.mpris.MediaPlayer2.TrackList interface below is implemented, and the
      track list is the user's station list. It is what tells a client to go looking for it.
    -->
    <property name="HasTrackList" type="b" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <property name="Identity" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <property name="DesktopEntry" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <property name="SupportedUriSchemes" type="as" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <property name="SupportedMimeTypes" type="as" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

  </interface>

  <!--
    Player interface. Unlike the root interface the spec puts EmitsChangedSignal on each
    property individually, and two of them are deliberately "false": Position (it moves
    continuously and is polled, never signalled) and CanControl (constant for the
    lifetime of the object).
  -->
  <interface name="org.mpris.MediaPlayer2.Player">

    <!--
      These step through the station list - which, since the TrackList interface went in, is
      also the track list, so they mean exactly what the spec says they mean.
    -->
    <method name="Next"/>
    <method name="Previous"/>

    <method name="Pause"/>
    <method name="PlayPause"/>
    <method name="Stop"/>
    <method name="Play"/>

    <!--
      Live streams cannot be seeked: CanSeek is false, so per the spec Seek() and
      SetPosition() are no-ops. Both stay in the interface because the spec requires
      them to be present.
    -->
    <method name="Seek">
      <arg name="Offset" type="x" direction="in"/>
    </method>

    <method name="SetPosition">
      <arg name="TrackId" type="o" direction="in"/>
      <arg name="Position" type="x" direction="in"/>
    </method>

    <method name="OpenUri">
      <arg name="Uri" type="s" direction="in"/>
    </method>

    <!--
      Never emitted by mradio (there is nothing to seek), but the signal is mandatory
      and generating it keeps the adaptor able to emit it should that change.
    -->
    <signal name="Seeked">
      <arg name="Position" type="x"/>
    </signal>

    <!-- "Playing" | "Paused" | "Stopped" -->
    <property name="PlaybackStatus" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <!--
      LoopStatus and Shuffle are optional in the spec and meaningless for a live
      stream, so they are left out; clients are required to cope with absence.
    -->

    <!-- Always 1.0 for a live stream; writes of any other value are rejected. -->
    <property name="Rate" type="d" access="readwrite">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <!--
      a{sv}: mpris:trackid (o), xesam:title, xesam:artist (as), xesam:url, xesam:album.
      mpris:trackid is the station's id in the TrackList below, as the spec requires of a
      player that has one - so it names the station, and does not change when the stream
      moves on to the next song. TrackMetadataChanged is what says that much.
    -->
    <property name="Metadata" type="a{sv}" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <!-- 0.0 .. 1.0, writable: the volume is settable over MPRIS. -->
    <property name="Volume" type="d" access="readwrite">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <!--
      Microseconds. Always 0 for mradio. EmitsChangedSignal is "false" as mandated by
      the spec: a running position must not be broadcast on PropertiesChanged.
    -->
    <property name="Position" type="x" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="false"/>
    </property>

    <!-- Both 1.0: no rate control on a live stream. -->
    <property name="MinimumRate" type="d" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <property name="MaximumRate" type="d" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <property name="CanGoNext" type="b" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <property name="CanGoPrevious" type="b" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <property name="CanPlay" type="b" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <property name="CanPause" type="b" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <!-- false: streams are not seekable. -->
    <property name="CanSeek" type="b" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

    <!--
      Constant, hence EmitsChangedSignal "false" per the spec. mradio reports true:
      the player does accept control from clients.
    -->
    <property name="CanControl" type="b" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="false"/>
    </property>

  </interface>

  <!--
    TrackList interface: mradio's stations, in playlist order.

    The track list is fixed. The playlist is read once at startup, so no track is ever added,
    removed or reordered and the three signals that would say so are never emitted. What does
    change is a track's metadata, when the station that is on moves to the next song, and that
    is what TrackMetadataChanged carries.

    A track id is /org/mpris/MediaPlayer2/mradio/station/<index>. A StationId cannot be used
    directly: it keeps the non-ASCII bytes of the station's name, and an object path may hold
    nothing but [A-Za-z0-9_] between its slashes.
  -->
  <interface name="org.mpris.MediaPlayer2.TrackList">

    <!--
      Unknown ids are left out of the answer rather than answered with an empty map: there is
      no way in the signature to say "no such track", and a{sv} without mpris:trackid in it
      would be a worse answer than a shorter array.
    -->
    <method name="GetTracksMetadata">
      <arg direction="in" name="TrackIds" type="ao"/>
      <arg direction="out" name="Metadata" type="aa{sv}"/>
    </method>

    <!--
      CanEditTracks is false, so per the spec these two "have no effect, and may raise a
      NotSupported error". mradio raises it: the station list comes from playlist.m3u and is
      not something a client can add to, and silence would look like success.
    -->
    <method name="AddTrack">
      <arg direction="in" name="Uri" type="s"/>
      <arg direction="in" name="AfterTrack" type="o"/>
      <arg direction="in" name="SetAsCurrent" type="b"/>
    </method>

    <method name="RemoveTrack">
      <arg direction="in" name="TrackId" type="o"/>
    </method>

    <!--
      The one method here that does something: it starts the station the id names, which is
      how a client picks a station over MPRIS at all. An id from anywhere else has no effect,
      as the spec requires.
    -->
    <method name="GoTo">
      <arg direction="in" name="TrackId" type="o"/>
    </method>

    <!-- Never emitted: the list is fixed for the lifetime of the process. -->
    <signal name="TrackListReplaced">
      <arg name="Tracks" type="ao"/>
      <arg name="CurrentTrack" type="o"/>
    </signal>

    <!-- Never emitted: CanEditTracks is false and nothing else adds or removes a station. -->
    <signal name="TrackAdded">
      <arg name="Metadata" type="a{sv}"/>
      <arg name="AfterTrack" type="o"/>
    </signal>

    <signal name="TrackRemoved">
      <arg name="TrackId" type="o"/>
    </signal>

    <!--
      Emitted for the station that is playing whenever the stream says it has moved on to
      something else. This is the signal that carries a new song, since mpris:trackid now
      stays put across one.
    -->
    <signal name="TrackMetadataChanged">
      <arg name="TrackId" type="o"/>
      <arg name="Metadata" type="a{sv}"/>
    </signal>

    <!--
      "invalidates" as mandated by the spec: PropertiesChanged is emitted without the new
      value, and clients are told to follow the TrackAdded/TrackRemoved/TrackListReplaced
      signals instead. mradio never changes the list, so it never emits either.
    -->
    <property name="Tracks" type="ao" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="invalidates"/>
    </property>

    <!-- false: the station list is a file the user edits, not a queue a client builds. -->
    <property name="CanEditTracks" type="b" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>

  </interface>

</node>
